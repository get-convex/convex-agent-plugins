{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "node ./scripts/pre-commit-checks.mjs",
        "matcher": "\\bgit\\s+commit\\b"
      }
    ],
    "stop": [
      {
        "command": "node ./scripts/stop-verify.mjs",
        "loop_limit": 2
      }
    ]
  }
}
